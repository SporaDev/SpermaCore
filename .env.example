# spermacore local environment. copy to .env and fill in values.
# .env is gitignored. real process environment always takes precedence.
#
# config.toml references these variables via ${NAME}; secrets stay out of git.

# --- telegram userbot (https://my.telegram.org) ---
SPERMACORE_TELEGRAM_API_ID=
SPERMACORE_TELEGRAM_API_HASH=
SPERMACORE_TELEGRAM_PHONE=
SPERMACORE_TELEGRAM_BOT_TOKEN=
# proxy for tdlib: socks5://127.0.0.1:7890. empty - auto-detect.
SPERMACORE_TELEGRAM_PROXY=
# encryption key for TDLib local database (SQLCipher AES-256)
SPERMACORE_TELEGRAM_DB_KEY=

# --- encryption (sqlcipher) ---
# encryption key for SQLite database (spermacore.db) via SQLCipher
SPERMACORE_DB_KEY=

# --- webui ---
# bearer token for /api/* and /ws. empty on loopback = temporary token logged at startup.
SPERMACORE_WEBUI_TOKEN=

# --- llm providers ---
# default provider configured in [llm.providers.reformboss].
REFORMBOSS_API_KEY=
# examples for other openai-compatible providers.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- text-to-speech (ГС) ---
# Fish Audio API key (default TTS provider). https://fish.audio/
FISH_AUDIO_API_KEY=